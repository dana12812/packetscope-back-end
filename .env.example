# Copy to .env (local) or add these as environment variables on your host.

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Usernames that become admin when they sign in, comma-separated.
# Sign up the account first, then add its username here.
ADMIN_USERNAMES=
