# Copy to .env (local) or add these as environment variables on your host.

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Front-end URLs allowed to call the API, comma-separated, no trailing slash
# e.g. http://localhost:5173,https://packetscope.vercel.app
CORS_ORIGINS=http://localhost:5173

# Usernames that become admin when they sign in, comma-separated.
# Sign up the account first, then add its username here.
ADMIN_USERNAMES=
